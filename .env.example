# Server-only. Configure this as a Sites secret; never commit a real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# Required in production: configure at least one hard owner allowlist value.
# Sites may supply email without a numeric user ID.
MOTH_OWNER_USER_ID=
MOTH_OWNER_EMAIL=
# Optional challenge mode: allows any signed-in ChatGPT user an isolated owner-scoped workspace.
# Keep OPENAI_API_KEY unset in public mode; judges can use the free guided example.
PUBLIC_DEMO_MODE=false
SITE_URL=
